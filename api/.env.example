# PostgreSQL connection (Neon: use the pooled connection string for runtime)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Direct (non-pooled) connection for migrations (Neon: direct endpoint)
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# JWT signing secret (any long random string)
JWT_SECRET="change-me-long-random-secret"

# Optional: hex-encoded voucher signing key. Must match the game PC's keys/voucher_secret.bin
# if a custom key was deployed there. Leave empty to use the derived master default.
VOUCHER_SECRET_HEX=""

# Comma-separated list of allowed CORS origins (the web app URL)
CORS_ORIGIN="http://localhost:3000"
